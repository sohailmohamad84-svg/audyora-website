# Audyora Production Environment Variables
# Copy this file to .env and configure for live backend integrations

# Contact Form API Endpoint (e.g., https://formspree.io/f/xyz or custom endpoint)
# If left empty, the contact form will operate in honest demonstration mode explaining setup.
VITE_CONTACT_API_URL=

# Optional public reCAPTCHA or Turnstile Site Key (if enabled)
VITE_CAPTCHA_SITE_KEY=
